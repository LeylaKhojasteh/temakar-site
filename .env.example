# نمونهٔ متغیرهای محیطی. مقادیر واقعی را در .env بگذار؛ .env در مخزن ذخیره نمی‌شود.

# امنیت
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
DJANGO_HSTS_SECONDS=31536000

# نشانی عمومی سایت (برای canonical، sitemap و OG)
SITE_URL=http://127.0.0.1:8000

# پستگرس
POSTGRES_DB=temakar
POSTGRES_USER=temakar
POSTGRES_PASSWORD=
# کلاستر محلی توسعه با scripts/dev-db.ps1 روی پورت 5439 بالا می‌آید.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5439

# ایمیل (اختیاری؛ خالی بماند، پیام‌ها فقط در دیتابیس ذخیره می‌شوند)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Temakar <no-reply@temakar.local>
CONTACT_NOTIFY_EMAIL=

# محدودیت فرم تماس
CONTACT_RATE_LIMIT_MAX=3
CONTACT_RATE_LIMIT_WINDOW=3600
CONTACT_MIN_FILL_SECONDS=3

# فقط توسعه: ساخت کاربر ادمین در seed دمو
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# فقط توسعه: اجرای موقت با SQLite بدون سرور پستگرس (در پروداکشن استفاده نشود)
# USE_SQLITE=1
