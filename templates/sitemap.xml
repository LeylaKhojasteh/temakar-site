<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{% for entry in entries %}  <url>
    <loc>{{ entry.en }}</loc>
    <xhtml:link rel="alternate" hreflang="en" href="{{ entry.en }}"/>
    <xhtml:link rel="alternate" hreflang="fa" href="{{ entry.fa }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ entry.en }}"/>
    {% if entry.lastmod %}<lastmod>{{ entry.lastmod|date:"c" }}</lastmod>{% endif %}
  </url>
  <url>
    <loc>{{ entry.fa }}</loc>
    <xhtml:link rel="alternate" hreflang="en" href="{{ entry.en }}"/>
    <xhtml:link rel="alternate" hreflang="fa" href="{{ entry.fa }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ entry.en }}"/>
    {% if entry.lastmod %}<lastmod>{{ entry.lastmod|date:"c" }}</lastmod>{% endif %}
  </url>
{% endfor %}</urlset>
